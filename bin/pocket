#!/usr/bin/env bash
# pocket — bring your own memory across CLI agents.
#
# Thin shim over the TypeScript CLI at cli/src/index.ts. Prefers the
# compiled single-file binary (cli/dist/pocket, built with `bun run build`)
# and falls back to `bun run cli/src/index.ts` for dev. The same agent-
# facing surface as before — see `pocket help`.

set -euo pipefail

resolve_root() {
  if [ -n "${POCKET_ROOT:-}" ]; then
    printf '%s\n' "$POCKET_ROOT"
    return
  fi
  if git rev-parse --show-toplevel >/dev/null 2>&1; then
    git rev-parse --show-toplevel
    return
  fi
  # Fall back to the parent of bin/.
  cd "$(dirname "$0")/.." && pwd
}

ROOT="$(resolve_root)"
export POCKET_ROOT="$ROOT"

COMPILED="$ROOT/cli/dist/pocket"
ENTRY="$ROOT/cli/src/index.ts"

if [ -x "$COMPILED" ]; then
  exec "$COMPILED" "$@"
fi

if ! command -v bun >/dev/null 2>&1; then
  echo "pocket: bun is required (https://bun.sh)" >&2
  exit 2
fi

if [ ! -f "$ENTRY" ]; then
  echo "pocket: missing cli/src/index.ts at $ENTRY" >&2
  exit 2
fi

exec bun run "$ENTRY" "$@"
