{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "POCKET_AGENT=claude bash \"$(git rev-parse --show-toplevel)/hooks/log.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "POCKET_AGENT=claude bash \"$(git rev-parse --show-toplevel)/hooks/log.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "POCKET_AGENT=claude bash \"$(git rev-parse --show-toplevel)/hooks/log.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
